    "test:web": "npm run build:site && playwright test"
  },
  "dependencies": {
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "marked": "^18.0.11",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24 <25"
  }
}
