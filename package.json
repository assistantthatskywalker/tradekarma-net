{
  "name": "tradekarma",
  "version": "0.1.0",
  "description": "Positive-Reinforcement E-Commerce Token Economy",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "abis": "node scripts/generate-abis.mjs",
    "test:chain": "npm run build && node scripts/test-chain-integration.mjs",
