# TradeKarma on-chain layer — deployment configuration
#
# Copy to .env and fill in. `forge script` loads .env from the project root
# automatically. .env is gitignored; this file must never contain real values.
#
#   cp .env.example .env
#
# THERE IS NO PRIVATE KEY IN THIS FILE AND THERE MUST NEVER BE ONE.
# The signer is supplied on the command line, per invocation:
#   --account <keystore-name>    imported once with `cast wallet import`
#   --ledger                     hardware wallet
#   --private-key <key>          local anvil only, never a funded key
#
# Runbook: script/README.md
#
# NOTE for whoever owns .gitignore: line 3 is `.env.*`, which matches this file
# and keeps it out of the repo. Add `!.env.example` so the template ships.

# ---------------------------------------------------------------------------
# Networks
# ---------------------------------------------------------------------------
# Use a provider URL with NO embedded API key committed anywhere. The public
# endpoints below are rate-limited but work for a deploy; swap in your own.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Chain ids, for reference — Base Sepolia 84532, Base mainnet 8453.

# For `forge script --verify`. Get one from basescan.org; keep it out of git.
BASESCAN_API_KEY=your-basescan-api-key

# ---------------------------------------------------------------------------
# Deployment inputs — all four are required by Deploy.s.sol
# ---------------------------------------------------------------------------

# The USDC the Treasury pays redemptions in. Treasury reads decimals() from
# this contract at construction and fixes `usdcScale` FOREVER, so a wrong
# address here misprices every redemption permanently.
#   Base Sepolia (84532): 0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   Base mainnet (8453):  0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Both are 6 decimals. Do not use bridged USDbC
# (0xd9aAEc86B65D86f6A7B5B1b0c42FFA531710b6CA) unless you mean to.
USDC_ADDRESS=0x0000000000000000000000000000000000000000

# The multi-sig. Ends up holding: DEFAULT_ADMIN_ROLE on KRUNE and KSHRD,
# ownership of Staking and Treasury, and the ENTIRE KDEX fixed supply.
# It must be a WALLET, not a contract that cannot move ERC-20s: KDEX's supply
# is minted here and the Treasury is funded from it afterwards by transfer.
# Until KSHRD's roles are locked, this address can mint unlimited KSHRD and
# drain the Treasury (audit C-01) — a Safe, not an EOA.
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# The off-chain settlement wallet that signs KRUNE `mintEarned`. Receives
# MINTER_ROLE on KRUNE and nothing else. This is a hot key in a server process:
# it must NOT equal ADMIN_ADDRESS, and Deploy.s.sol refuses if it does.
EARNING_ENGINE_BRIDGE=0x0000000000000000000000000000000000000000

# KDEX fixed supply, in wei, minted once at construction and never again.
# 100000000000000000000000000 = 100,000,000 KDEX. Getting this wrong is
# permanent — there is no mint function after deployment.
KDEX_INITIAL_SUPPLY=100000000000000000000000000

# ---------------------------------------------------------------------------
# Deployed addresses — Deploy.s.sol prints these; paste them back for
# Verify.s.sol and LockRoles.s.sol
# ---------------------------------------------------------------------------
KRUNE_ADDRESS=
KDEX_ADDRESS=
KSHRD_ADDRESS=
STAKING_ADDRESS=
TREASURY_ADDRESS=

# The key that ran Deploy.s.sol. Optional, and worth setting: Verify.s.sol
# asserts it holds no role on any contract. It held KSHRD's admin role during
# the deployment, so proving it gave that up is the highest-value check here.
DEPLOYER_ADDRESS=

# ---------------------------------------------------------------------------
# Verification / lock flags
# ---------------------------------------------------------------------------

# What Verify.s.sol should expect `KarmaShard.rolesLocked()` to be.
# false before LockRoles.s.sol, true after. Flip it only once you have locked.
EXPECT_ROLES_LOCKED=false

# LockRoles.s.sol refuses to run unless this is set to the exact phrase:
#   I UNDERSTAND THIS IS IRREVERSIBLE
# Leave it EMPTY. `KarmaShard.lockRoles()` cannot be undone by anyone, ever:
# it permanently freezes which addresses may mint and burn KSHRD. Locking
# before MINTER_ROLE and BURNER_ROLE have landed makes KSHRD unmintable and
# every staker's yield unclaimable, forever. Read script/README.md first.
CONFIRM_LOCK_ROLES=
